# Copy to `.env` and adjust. Real environment variables take precedence over this file.

# Interface/port the API binds to. 0.0.0.0 is required for physical devices on the LAN.
HOST=0.0.0.0
PORT=5000

# PostgreSQL connection string for the application database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/salon_booking

# Separate database used by the integration test suite (it is reset on every run).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/salon_booking_test

# Time zone the salons operate in. Booking dates/times are interpreted in this zone.
TZ=Asia/Dubai

# How far ahead customers may book, and the slot granularity.
BOOKING_WINDOW_DAYS=60
SLOT_INTERVAL_MINUTES=30
